#!/usr/bin/env bash
# Run a claude-profiles profile on a REMOTE Windows box (set up by
# remote/windows-setup.ps1 + remote/wsl-setup.sh) over SSH. The agent runs in
# WSL Ubuntu — or, with --win, as the native Windows claude.exe.
#
#   claude-remote <litellm|sub1|sub2> [--cwd DIR] [claude args...]
#       -p "…"      → headless sub-agent; output streams back here
#       no -p       → interactive session in this terminal (dies with the SSH link)
#   claude-remote <litellm|sub1|sub2> --session NAME [--cwd DIR] [claude args...]
#       → persistent agent in the box's (Windows) herdr; returns immediately.
#         NAME: letters, digits, - and _ only.
#         Opens a tab NAME in the box's herdr workspace "agents"; refuses a NAME already there.
#         Watch/attach:  ssh -t "$CLAUDE_REMOTE_HOST" 'agent-box\herdr.cmd'
#   --win       → run the native Windows claude.exe instead of the WSL one
#                 (default cwd: the C: clone, ~/winhome/CascadeProjects/AM-PM)
#
# Capacity: refuses (exit 75, reason given) when the laptop has < 4 GB RAM free, CPU > 85%, or
# already runs $CLAUDE_REMOTE_MAX agents (backstop, default 16) — checked there by bin/remote-capacity.
# Host: $CLAUDE_REMOTE_HOST (default "win", an ~/.ssh/config alias).
# SSH forwards no env vars, so this session's ANTHROPIC_* / CLAUDE_* never leak
# into the remote run (the local `env -u` dance is not needed).
set -euo pipefail

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
[[ $# -ge 1 ]] || usage
profile="$1"; shift
case "$profile" in litellm | sub1 | sub2) ;; *) usage ;; esac

# shellcheck source=remote-lib.sh
source "$(dirname "$(readlink -f "$0")")/remote-lib.sh"
host="$REMOTE_HOST"
max="${CLAUDE_REMOTE_MAX:-16}"
[[ "$max" =~ ^[0-9]+$ ]] || { echo "CLAUDE_REMOTE_MAX must be a number" >&2; exit 2; }
cwd=""
session=""
target=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --cwd) cwd="$2"; shift 2 ;;
    --session) session="$2"; shift 2 ;;
    --win) target="env CLAUDE_PROFILE_TARGET=windows "; shift ;;
    *) break ;;
  esac
done
rhome='~' # ponytail: quoted on purpose — expands on the REMOTE side
if [[ -z "$cwd" && -n "$target" ]]; then cwd="$rhome/winhome/CascadeProjects/AM-PM"
elif [[ -z "$cwd" ]]; then cwd="$rhome/CascadeProjects/AM-PM"; fi
launcher="$rhome/PersonalScripts/claude-profiles/bin/claude-$profile"
args=""
[[ $# -gt 0 ]] && args="$(printf '%q ' "$@")"

# SSH lands in Windows cmd. The bash script travels as ONE base64 argument to
# bin/b64run in WSL: the hop is only [A-Za-z0-9+/=] — nothing cmd, PowerShell (herdr
# panes) or wsl.exe can mangle — and stdin stays free for `cat f | claude-remote sub2 -p …`.
# Capacity is checked ON the box right before exec — not here — so parallel launches race only
# for the ~2 s the check takes.
cap="PersonalScripts/claude-profiles/bin/remote-capacity $max"
hop() { echo "wsl.exe -d Ubuntu --cd ~ -e PersonalScripts/claude-profiles/bin/b64run $(printf '%s' "$1" | base64 | tr -d '\n')"; }
wsl="$(hop "$cap; cd $cwd && exec $target$launcher $args")"
remote_warm

if [[ -n "$session" ]]; then
  [[ "$session" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "--session NAME: letters, digits, - and _ only" >&2; exit 2; }
  # herdr 0.9.5: tab in workspace "agents", then `pane run` types the hop + Enter into its shell.
  # (Its JSON leaves Windows backslashes unescaped, so ids are grepped, not jq'd.)
  herdr='%USERPROFILE%\agent-box\herdr.cmd'
  field() { grep -o "\"$1\":\"[^\"]*\"" | head -1 | cut -d'"' -f4; }
  ws="$(ssh "$host" "$herdr workspace list" | tr -d '\r' | grep -o '{[^{}]*"label":"agents"[^{}]*}' | field workspace_id || true)"
  [[ -n "$ws" ]] || ws="$(ssh "$host" "$herdr workspace create --label agents --no-focus" | tr -d '\r' | field workspace_id)"
  if ssh "$host" "$herdr tab list --workspace $ws" | grep -q "\"label\":\"$session\""; then
    echo "herdr: a session named $session already exists — pick another name" >&2; exit 2
  fi
  ssh "$host" "$(hop "$cap")"  # refuse now, not silently inside a pane, when the laptop is full
  pane="$(ssh "$host" "$herdr tab create --workspace $ws --label $session --no-focus" | tr -d '\r' | field pane_id)"
  [[ -n "$pane" ]] || { echo "herdr: could not create tab $session" >&2; exit 1; }
  ssh "$host" "$herdr pane run $pane \"$wsl\"" >/dev/null
  echo "started $session in herdr pane $pane — attach: ssh -t $host 'agent-box\\herdr.cmd'"
  exit 0
fi
tty=()
[[ -t 0 && " $* " != *" -p "* && " $* " != *" --print "* ]] && tty=(-t)
exec ssh ${tty[@]+"${tty[@]}"} "$host" "$wsl"
