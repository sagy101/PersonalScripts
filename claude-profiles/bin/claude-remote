#!/usr/bin/env bash
# Run a claude-profiles profile on a REMOTE Windows box (set up by
# remote/windows-setup.ps1 + remote/wsl-setup.sh) over SSH. The agent runs in
# WSL Ubuntu — or, with --win, as the native Windows claude.exe.
#
#   claude-remote <litellm|sub1|sub2> [--cwd DIR] [claude args...]
#       -p "…"      → headless sub-agent; output streams back here
#       no -p       → interactive session in this terminal (dies with the SSH link)
#   claude-remote <litellm|sub1|sub2> --session NAME [--cwd DIR] [claude args...]
#       → persistent agent in the box's (Windows) herdr; returns immediately.
#         NAME: letters, digits, - and _ only.
#         Watch/attach:  herdr --remote "$CLAUDE_REMOTE_HOST"
#   --win       → run the native Windows claude.exe instead of the WSL one
#                 (default cwd: the C: clone, ~/winhome/CascadeProjects/AM-PM)
#
# Host: $CLAUDE_REMOTE_HOST (default "win", an ~/.ssh/config alias).
# SSH forwards no env vars, so this session's ANTHROPIC_* / CLAUDE_* never leak
# into the remote run (the local `env -u` dance is not needed).
set -euo pipefail

usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
[[ $# -ge 1 ]] || usage
profile="$1"; shift
case "$profile" in litellm | sub1 | sub2) ;; *) usage ;; esac

host="${CLAUDE_REMOTE_HOST:-win}"
cwd=""
session=""
target=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --cwd) cwd="$2"; shift 2 ;;
    --session) session="$2"; shift 2 ;;
    --win) target="env CLAUDE_PROFILE_TARGET=windows "; shift ;;
    *) break ;;
  esac
done
rhome='~' # ponytail: quoted on purpose — expands on the REMOTE side
if [[ -z "$cwd" && -n "$target" ]]; then cwd="$rhome/winhome/CascadeProjects/AM-PM"
elif [[ -z "$cwd" ]]; then cwd="$rhome/CascadeProjects/AM-PM"; fi
launcher="$rhome/PersonalScripts/claude-profiles/bin/claude-$profile"
args=""
[[ $# -gt 0 ]] && args="$(printf '%q ' "$@")"

# SSH lands in Windows cmd. Ship the bash script as base64 (only [A-Za-z0-9+/=],
# so neither cmd nor wsl.exe's argv parsing can mangle it) and run it via
# process substitution — that keeps stdin free for `cat f | claude-remote sub2 -p …`.
script="cd $cwd && exec $target$launcher $args"
b64="$(printf '%s\n' "$script" | base64 | tr -d '\n')"
wsl="wsl.exe -d Ubuntu -e bash -c \"bash -l <(echo $b64 | base64 -d)\""

if [[ -n "$session" ]]; then
  [[ "$session" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "--session NAME: letters, digits, - and _ only" >&2; exit 2; }
  exec ssh "$host" "herdr agent start $session --no-focus -- $wsl"
fi
tty=()
[[ -t 0 && " $* " != *" -p "* && " $* " != *" --print "* ]] && tty=(-t)
exec ssh ${tty[@]+"${tty[@]}"} "$host" "$wsl"
